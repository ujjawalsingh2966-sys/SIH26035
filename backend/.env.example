# Use a private random secret (at least 32 characters); never commit backend/.env.
PORT=4000
NODE_ENV=development
JWT_SECRET=<replace-with-a-local-random-secret>
# Required in production. If omitted locally, a private random key is persisted
# in DATA_DIR/authSecrets.json. No shared development signing key is accepted.
# Comma-separated exact frontend origins. Include the origin shown in your browser.
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3014
# Optional absolute directory for an isolated synthetic dataset.
# DATA_DIR=<absolute-path-to-isolated-data>
# Explicit default. Do not activate postgres against real data before Phase 2B.3 approval.
PERSISTENCE_ADAPTER=json
# PostgreSQL adapter source is mock-tested only; schema/RLS/import are not implemented.
# Never expose these as NEXT_PUBLIC_* or commit populated environment files.
# DATABASE_URL=<private-supabase-transaction-pooler-url>
# DATABASE_POOL_MAX=2  # Integer 1-5; limit applies per running Node.js instance.
# Optional trusted CA PEM if the endpoint needs a custom trust root. No TLS bypass.
# DATABASE_SSL_CA=<trusted-ca-certificate-pem>
# Initial Administrator: stop the backend, supply these privately in the process
# environment and run npm run staff:bootstrap after building. No default account.
# W8LAB_BOOTSTRAP_NAME=<administrator-name>
# W8LAB_BOOTSTRAP_EMAIL=<administrator-email>
# W8LAB_BOOTSTRAP_PASSWORD=<private-12-to-128-character-password>
# W8LAB_BOOTSTRAP_ADOPT_LEGACY=1  # ONLY for a verified recognized legacy identity
